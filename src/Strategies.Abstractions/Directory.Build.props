<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Suppressions for the existing public API, which the Strategies package depends on:
    - CA1716: Operator and When conflict with VB keywords; renaming them would break consumers.
    - RS0026: the When overloads already ship with optional parameters.
    - CS1591: public members are not yet XML-documented.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1716;RS0026;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
